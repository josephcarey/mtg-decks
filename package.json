{
  "name": "mtg-decks",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "MTG Commander deck-building workspace tooling (Bun + TypeScript).",
  "module": "src/cli.ts",
  "scripts": {
    "deck": "bun src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && knip && eslint . && bun audit",
    "test": "vitest run --coverage",
    "ci": "bun run check && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/bun": "^1.1.14",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.15.0",
    "eslint-plugin-depend": "^0.12.0",
    "eslint-plugin-perfectionist": "^4.2.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "knip": "^5.38.0",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite": "^7.1.12",
    "esbuild": "^0.25.10"
  },
  "dependencies": {
    "neverthrow": "^8.2.0"
  }
}
